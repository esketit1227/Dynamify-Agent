# --- Playwright ---
# Leave unset in a normal deployment where `npx playwright install` was run
# for this exact `playwright` package version. Set this only when the
# sandbox/CI image pre-installs a Chromium revision that doesn't match what
# this package version expects to auto-resolve (mismatched-revision launch
# errors mentioning chrome-headless-shell are the symptom) — point it at the
# real binary instead of downloading a second copy.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- Database ---
# Postgres connection string used by Drizzle and by pg-boss for the job queue.
DATABASE_URL=postgres://dynamify:dynamify@localhost:5432/dynamify_scout

# --- OpenAI ---
# Used by every research/analysis/generation agent via the Responses API.
OPENAI_API_KEY=
# Model used for reasoning-heavy agents (research, scoring, opportunity selection).
OPENAI_RESEARCH_MODEL=gpt-5.1
# Model used for content generation (preview copy, report writing, outreach drafts).
OPENAI_WRITING_MODEL=gpt-5.1

# --- Object storage for screenshots / captured assets ---
# "local" writes to ./storage on disk (default, good for dev).
# "s3" writes to the S3-compatible bucket configured below.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Outreach email provider ---
# Sending is always gated behind explicit human approval in the app (see
# src/lib/email/provider.ts). Leave EMAIL_PROVIDER unset/"log" during
# development — outbound "sends" are recorded but not actually delivered.
EMAIL_PROVIDER=log
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=scout@dynamify.example

# --- App ---
NEXT_PUBLIC_APP_NAME="Dynamify Scout"
# Internal auth is intentionally out of scope for this scaffold; put this
# behind SSO/VPN before exposing it beyond localhost.
